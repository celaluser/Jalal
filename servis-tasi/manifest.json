{
  "manifest_version": 3,
  "name": "Pasif Servis Taşı — Not Assigned",
  "short_name": "Pasif Servis Taşı",
  "version": "1.2.0",
  "description": "Perfect Panel Services sayfasında aktif kategorilerdeki pasif servisleri bulur; kutucuklarını işaretleyip toplu Actions → Assign category ile Not Assigned'a taşır. Otomatik mod: her N dakikada sayfayı yenileyip yeniden taşır. Deneme modu, grup boyutu, durdur; arka planda da çalışır.",
  "minimum_chrome_version": "103",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://panelbaku.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://panelbaku.com/admin/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pasif Servis Taşı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
