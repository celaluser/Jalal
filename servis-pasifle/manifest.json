{
  "manifest_version": 3,
  "name": "Servis Pasifle — Not Assigned",
  "short_name": "Servis Pasifle",
  "version": "1.2.2",
  "description": "Perfect Panel Services sayfasında Not Assigned kategorisindeki aktif servisleri bulur ve pasife alır (Disable service). Otomatik mod: her N dakikada sayfayı yenileyip yeniden kontrol eder. Deneme modu, durdur, en çok N; arka planda da çalışır.",
  "minimum_chrome_version": "103",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://panelbaku.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://panelbaku.com/admin/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Servis Pasifle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
