{
  "manifest_version": 3,
  "name": "Panel Araçları — Perfect Panel",
  "short_name": "Panel Araçları",
  "version": "2.2.0",
  "description": "Perfect Panel Services sayfası için üç araç tek eklentide: Kategori Temizle (boş/pasif kategoriler), Servis Pasifle (Not Assigned'daki aktif servisler), Pasif Servis Taşı (pasif servisleri Not Assigned'a). Deneme modu, durdur, otomatik mod; arka planda da çalışır.",
  "minimum_chrome_version": "103",
  "permissions": [
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://panelbaku.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://panelbaku.com/admin/*"
      ],
      "js": [
        "ortak.js",
        "kategori.js",
        "pasifle.js",
        "tasi.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Panel Araçları",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Panel Araçları mini panelini aç"
    }
  }
}
